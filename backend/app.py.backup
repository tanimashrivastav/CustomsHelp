from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from typing import List, Dict, Any
import requests
import numpy as np
import os
import re
from bs4 import BeautifulSoup
from google import genai
import cv2
from ultralytics import YOLO

# Load your trained YOLO model ONCE at startup
MODEL_PATH = "best.pt"
model = YOLO(MODEL_PATH)

app = FastAPI()

# Allow browser apps (Lovable UI) to call this API (CORS)
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],   # later restrict to your Lovable domain
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

class DetectRequest(BaseModel):
    urls: List[str]      # public image URLs
    imgsz: int = 512     # inference image size
    conf: float = 0.25   # confidence threshold

def detect_from_url(url: str, imgsz: int, conf: float) -> Dict[str, Any]:
    # Download image bytes
    r = requests.get(url, timeout=25)
    r.raise_for_status()

    # Decode bytes -> OpenCV image (BGR)
    data = np.frombuffer(r.content, dtype=np.uint8)
    img = cv2.imdecode(data, cv2.IMREAD_COLOR)
    if img is None:
        return {"url": url, "error": "Could not decode image"}

    # Run YOLO
    pred = model.predict(img, imgsz=imgsz, conf=conf, verbose=False)[0]

    # Return JSON-friendly detections + image size (for UI scaling)
    h, w = img.shape[:2]
    dets = []
    if pred.boxes is not None and len(pred.boxes) > 0:
        boxes = pred.boxes.xyxy.cpu().numpy()
        confs = pred.boxes.conf.cpu().numpy()
        clss  = pred.boxes.cls.cpu().numpy().astype(int)
        names = pred.names

        for (x1, y1, x2, y2), c, k in zip(boxes, confs, clss):
            dets.append({
                "class_id": int(k),
                "class_name": names[int(k)],
                "confidence": float(c),
                "bbox_xyxy": [float(x1), float(y1), float(x2), float(y2)],
            })

    return {"url": url, "image_w": w, "image_h": h, "detections": dets}

@app.get("/health")
def health():
    return {"ok": True}

@app.post("/detect")
def detect(req: DetectRequest):
    results = [detect_from_url(u, req.imgsz, req.conf) for u in req.urls]
    return {"results": results}

# -----------------------------
# Agentic enrichment (Gemini): /object-info
# -----------------------------

class ObjectInfoRequest(BaseModel):
    class_name: str
    context: str = "airport"
    jurisdiction: str = "US"

def _html_to_text(html: str) -> str:
    """Extract readable text from HTML for use as evidence."""
    soup = BeautifulSoup(html, "html.parser")
    for tag in soup(["script", "style", "noscript"]):
        tag.decompose()
    text = soup.get_text(separator="\n")
    text = re.sub(r"\n{3,}", "\n\n", text)
    text = re.sub(r"[ \t]{2,}", " ", text)
    return text.strip()

def _fetch_text(url: str, timeout: int = 20) -> str:
    """Fetch a URL and return cleaned text (best effort)."""
    try:
        r = requests.get(url, timeout=timeout, headers={"User-Agent": "Mozilla/5.0"})
        r.raise_for_status()
        return _html_to_text(r.text)
    except Exception as e:
        return f"[FETCH_ERROR] {url} -> {type(e).__name__}: {e}"

def _plan_sources(class_name: str, jurisdiction: str):
    """
    Very small 'planner/router' step:
    chooses which trusted sources to retrieve before calling Gemini.
    """
    item = (class_name or "").lower().strip()
    src = []

    if jurisdiction.upper() == "US":
        # General TSA anchor page
        src.append({
            "title": "TSA - What Can I Bring?",
            "url": "https://www.tsa.gov/travel/security-screening/whatcanibring/all"
        })

    # Battery / power bank / charger category
    if any(k in item for k in ["battery", "charger", "power", "portable", "lithium"]):
        src.append({
            "title": "FAA - PackSafe Lithium Batteries",
            "url": "https://www.faa.gov/hazmat/packsafe/lithium-batteries"
        })

    # Liquids / water / cosmetics category
    if any(k in item for k in ["liquid", "water", "cosmetic", "gel", "toiletry"]):
        src.append({
            "title": "TSA - Liquids Rule (3-1-1)",
            "url": "https://www.tsa.gov/travel/security-screening/liquids-rule"
        })

    # Keep it small for speed
    return src[:3]

def _call_gemini_for_json(item: str, context: str, jurisdiction: str, sources, evidence: str):
    """
    Gemini step: produce strict JSON grounded ONLY in the evidence we fetched.
    """
    api_key = os.getenv("GEMINI_API_KEY")
    if not api_key:
        return {
            "item": item,
            "summary": "",
            "travel_notes": "",
            "handling_guidance": "",
            "sources": sources,
            "limitations": "Server missing GEMINI_API_KEY environment variable."
        }

    client = genai.Client(api_key=api_key)

    prompt = f"""
Return ONLY valid JSON (no markdown, no extra text) using this schema:

{{
  "item": string,
  "summary": string,
  "travel_notes": string,
  "handling_guidance": string,
  "sources": [{{"title": string, "url": string}}],
  "limitations": string
}}

Rules:
- Use ONLY the EVIDENCE below.
- If the evidence does not mention something, say that in "limitations" instead of guessing.
- Keep each field concise (2-5 sentences max).

Inputs:
- item: {item}
- context: {context}
- jurisdiction: {jurisdiction}

SOURCES (copy exactly into the "sources" field):
{sources}

EVIDENCE:
{evidence}
"""

 try:
    resp = client.models.generate_content(
        model="models/gemini-2.0-flash-lite",
        contents=prompt
    )
    text = getattr(resp, "text", "") or ""
    return _extract_json_from_text(text)

except Exception as e:
    return {
        "item": item,
        "summary": f"(Fallback) Gemini unavailable: {type(e).__name__}",
        "danger_level": "unknown",
        "travel_notes": [],
        "handling_guidance": [],
        "sources": [],
        "limitations": ["LLM enrichment failed; returned fallback."],
        "error": str(e)[:300],
    }


    # Best-effort JSON parsing with safe fallback
    try:
        import json
        return json.loads(text)
    except Exception:
        return {
            "item": item,
            "summary": "Gemini returned a non-JSON response.",
            "travel_notes": "",
            "handling_guidance": "",
            "sources": sources,
            "limitations": f"Raw output (truncated): {text[:600]}"
        }

@app.post("/object-info")
def object_info(req: ObjectInfoRequest):
    """
    Agentic endpoint (3 components):
    1) Plan sources (router)
    2) Retrieve evidence (fetch URLs)
    3) Synthesize structured answer (Gemini)
    """
    item = (req.class_name or "").strip()
    if not item:
        return {"error": "class_name is required"}

    sources = _plan_sources(item, req.jurisdiction)

    # Retrieval action: fetch evidence text from sources
    chunks = []
    for s in sources:
        chunks.append(f"\n\n--- SOURCE: {s['title']} ({s['url']}) ---\n")
        txt = _fetch_text(s["url"])
        chunks.append(txt[:4000])  # keep evidence small for speed/tokens

    evidence = "\n".join(chunks)

    return _call_gemini_for_json(
        item=item,
        context=req.context,
        jurisdiction=req.jurisdiction,
        sources=sources,
        evidence=evidence
    )

